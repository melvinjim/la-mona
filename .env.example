# Copia este archivo como .env.local y llena los valores.
# En Vercel las mismas variables van en Settings -> Environment Variables.

# Dominio público del sitio, para los enlaces que se comparten por WhatsApp.
NEXT_PUBLIC_SITE_URL=https://lamona.com.co

# Supabase: Project Settings -> API, en supabase.com.
# Sin estas dos, el sitio funciona igual pero con el menú de src/data y el panel
# administrativo solo muestra las instrucciones de configuración.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
