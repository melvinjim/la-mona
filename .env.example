# Copia este archivo como .env.local y llena los valores.
# En Vercel las mismas variables van en Settings -> Environment Variables.

# Dominio público del sitio: lo usan los enlaces compartidos, el mapa del sitio y el código QR de las mesas.
NEXT_PUBLIC_SITE_URL=https://restlamona22.com

# Supabase: boton "Connect" del panel, o Settings -> API Keys, en supabase.com.
# Usa la llave "publishable" (empieza por sb_publishable_), nunca la "secret".
# Sin estas dos, el sitio funciona igual pero con el menú de src/data y el panel
# administrativo solo muestra las instrucciones de configuración.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional. Solo si verificas el sitio en Google Search Console con la etiqueta HTML
# (si lo verificas por DNS, que es lo recomendable, no hace falta).
# GOOGLE_SITE_VERIFICATION=el-codigo-que-da-search-console
